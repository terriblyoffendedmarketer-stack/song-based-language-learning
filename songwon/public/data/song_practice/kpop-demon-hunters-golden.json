          "english": "eternally",
          "role": "adverb"
        },
        {
          "korean": "깨질",
          "english": "to be broken",
          "role": "verb"
        },
        {
          "korean": "수 없는",
          "english": "cannot be",
          "role": "expression"
        }
      ],
      "grammar": {
        "pattern": "-(으)ㄹ 수 없는",
        "meaning": "cannot be [verb]-ed",
        "note": "깨지다 (to break/shatter) + ㄹ 수 없는 creates a modifier meaning 'that cannot be broken' — the -(으)ㄴ ending modifies the noun that follows"
      }
    },
