      "korean": "어두워진 앞길속에",
      "english": "inside the path ahead that had gone dark",
      "words": [
        {
          "korean": "어두워진",
          "english": "that has become dark",
          "role": "adjective"
        },
        {
          "korean": "앞길",
          "english": "the path ahead",
          "role": "noun"
        },
        {
          "korean": "속에",
          "english": "inside",
          "role": "particle"
        }
      ],
      "grammar": {
        "pattern": "-어/아지다",
        "meaning": "to become [adjective]",
        "note": "어둡다 (dark) + 어지다 creates 어두워지다 (to become dark), then -ㄴ makes it a past modifier: 'that has become dark'"
      }
    },
    {
      "korean": "끝없이 on stage",
      "english": "endlessly on stage",
      "words": [
        {
          "korean": "끝",
          "english": "end",
          "role": "noun"
        },
        {
          "korean": "없이",
          "english": "without",
          "role": "particle"
        }
      ],
      "grammar": {
        "pattern": "없이",
        "meaning": "without",
        "note": "When attached to a noun, 없이 means 'without [noun]' — here 끝없이 literally means 'without end,' i.e., endlessly"
      }
    },
    {
      "korean": "영원히 깨질 수 없는",
      "english": "eternally unbreakable",
